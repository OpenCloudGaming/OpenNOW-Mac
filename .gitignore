# Remote Co-Op local service state and secrets

# Unattended NVST experiment tooling (autopilot harness, frame dumper, one-shot experiment
# runner). Env-gated at every entry point (OPN_NVST_AUTORUN_*, OPN_NVST_FRAME_DUMP_*) so it is
# inert unless deliberately armed, but it is local debugging infrastructure, not shipping product
# code — kept out of the tracked tree on purpose.
OPN/Services/NvstAutopilot.swift
OPN/Stream/NvstFrameDumper.swift
Tests/Stream/NvstAutopilotTests.swift
scripts/nvst-experiment.sh

# NVST protocol reverse-engineering notes: investigation logs, disassembly findings, byte-level
# wire-format observations. Kept locally for reference, not published in the tracked tree.
docs/NVST/*

# Local tooling state (Serena MCP code-navigation config)
.serena/

# Local dependency clones and throwaway spikes (never committed).
.deps/
spikes/

